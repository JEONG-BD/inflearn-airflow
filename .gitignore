# ============================================================
# Git
# ============================================================

# Git repository metadata
.git/

# ============================================================
# Environment / OS
# ============================================================

# Environment variables (may contain secrets)
.env

# macOS metadata
.DS_Store

# Python virtual environment
.venv/

# Python bytecode cache
__pycache__/


# ============================================================
# Astro CLI
# ============================================================

# Astro CLI local executable / generated file
astro

# Astro standalone local environment
.astro/standalone/

# Astro worktree environments
.astro/worktrees/

# Astro local configuration files
.astro/*.local.yml
.astro/*.local.yaml


# ============================================================
# Apache Airflow
# ============================================================

# Local-only Airflow connections, variables, and pools
airflow_settings.yaml

# Airflow webserver process ID
airflow-webserver.pid

# Airflow webserver configuration
webserver_config.py

# Generated Airflow configuration
airflow.cfg

# Local Airflow SQLite metadata database
airflow.db


# ============================================================
# dbt / Astro generated metadata
# ============================================================

# dbt metadata generated by Astro
**/.astro/dbt_metadata.json

# Slim dbt manifest generated by Astro
**/.astro/manifest.slim.json